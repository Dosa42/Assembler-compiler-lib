{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apk-engine:integration:1",
  "type": "object",
  "required": ["schema", "timestamp_utc", "execution_kind", "native_executed", "cases", "cli_coverage", "mcp_coverage", "expected_tools", "calls", "brokkr_executions", "brokkr_usb_scope", "fixtures_keys_and_scratch_removed", "comment_policy", "passed"],
  "properties": {
    "schema": {"const": "apk-engine.integration/1"},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["jvm", "native"]},
    "native_executed": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "passed", "elapsed_seconds"], "properties": {"name": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "elapsed_seconds": {"type": "number", "minimum": 0}}}},
    "cli_coverage": {"$ref": "#/$defs/toolNames"},
    "mcp_coverage": {"$ref": "#/$defs/toolNames"},
    "expected_tools": {"$ref": "#/$defs/toolNames"},
    "calls": {"type": "array", "items": {"type": "object", "required": ["command", "exit_code", "stdout", "stderr"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exit_code": {"type": "integer"}, "stdout": {"type": "string"}, "stderr": {"type": "string"}}}},
    "brokkr_executions": {"type": "array", "items": {"type": "object", "required": ["transport", "tool", "expected_native_error"], "properties": {"transport": {"enum": ["cli", "mcp"]}, "tool": {"type": "string", "minLength": 1}, "expected_native_error": {"type": "boolean"}}, "additionalProperties": false}},
    "brokkr_usb_scope": {"const": "regular-file SCM_RIGHTS fixture; probe and flash execute native rejection; no physical USB"},
    "fixtures_keys_and_scratch_removed": {"type": "boolean"},
    "comment_policy": {"type": "object"},
    "passed": {"type": "boolean"}
  },
  "$defs": {"toolNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
