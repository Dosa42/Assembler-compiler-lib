        "libcxx_termux_recipe_commit": {
          "type": "string"
        },
        "binary_origin": {
          "type": "string"
        },
        "libcxx_notice_scope": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "url": {
                "type": "string"
              },
              "symlink": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
