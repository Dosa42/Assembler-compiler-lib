      "required": [
        "schema",
        "producer",
        "passed",
        "records_validated",
        "source_files_verified",
        "dependency_files_verified",
        "artifacts_verified",
        "authored_files_scanned",
        "semantic_review"
      ],
      "additionalProperties": false
