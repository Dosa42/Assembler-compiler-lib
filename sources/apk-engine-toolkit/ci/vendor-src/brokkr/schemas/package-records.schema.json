        "dependency_files_verified": {
          "type": "integer",
          "minimum": 1
        },
        "artifacts_verified": {
          "type": "integer",
          "minimum": 1
        },
        "authored_files_scanned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantic_review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
