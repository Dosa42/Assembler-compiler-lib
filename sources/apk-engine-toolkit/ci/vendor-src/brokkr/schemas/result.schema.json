        "path",
        "structural_valid",
        "md5_status",
        "md5_verified",
        "bytes_hashed",
        "images_checked"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "md5_status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "md5_verified": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "md5_verified": {
                "const": false
              },
              "bytes_hashed": {
                "const": 0
              }
            }
          }
        }
      ]
