          "type": "string"
        },
        "structural_valid": {
          "const": true
        },
        "md5_status": {
          "enum": [
            "verified",
            "absent"
          ]
        },
        "md5_verified": {
          "type": "boolean"
        },
        "bytes_hashed": {
          "type": "integer",
          "minimum": 0
